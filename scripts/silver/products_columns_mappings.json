{
  "biggie": {
    "type": "json",
    "path": "biggie/productos/",
    "columns": {
      "code": "product_id",
      "name": "product_name",
      "brand.name": "brand",
      "price": "price",
      "unitOfMeasure": "unit_of_measure",
      "isOnOffer": "is_on_promotion",
      "priceSaleOffer": "promotion_price",
      "category": "category_slug",
      "ingestion_time": "ingestion_time"
    }
  },

  "real": {
    "type": "json",
    "path": "real/productos/",
    "columns": {
      "sku": "product_id",
      "name": "product_name",
      "brand": "brand",
      "price": "price",
      "promotion.conditions[].price": "promotion_price",
      "category": "category_slug",
      "ingestion_time": "ingestion_time"
    }
  },

  "superseis": {
    "type": "csv",
    "path": "s6/productos/",
    "columns": {
      "titulo": "product_name",
      "marca": "brand",
      "precio": "price",
      "unidad_medida": "unit_of_measure",
      "category_slug": "category_slug",
      "ingestion_time": "ingestion_time"
    }
  },

  "stock": {
    "type": "csv",
    "path": "stock/productos/",
    "columns": {
      "titulo": "product_name",
      "marca": "brand",
      "precio": "price",
      "unidad_medida": "unit_of_measure",
      "category_slug": "category_slug",
      "ingestion_time": "ingestion_time"
    }
  },

  "casarica": {
    "type": "csv",
    "path": "casa_rica/productos/",
    "columns": {
      "titulo": "product_name",
      "precio": "price",
      "category_slug": "category_slug",
      "ingestion_time": "ingestion_time"
    }
  }
}
