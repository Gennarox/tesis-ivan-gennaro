{
  "name": "tesis-ivan-gennaro",
  "build": {
    "dockerfile": "../Dockerfile.dev"
  },
  "settings": {
    "python.defaultInterpreterPath": "/usr/local/bin/python"
  },
  "extensions": [
    "ms-python.python",
    "ms-toolsai.jupyter"
  ],
  "postCreateCommand": "pip install -r /app/requirements.txt",
  "remoteUser": "root",
  "remoteEnv": {
    "DB_DSN": "host=192.168.100.54 port=5432 dbname=myapp user=admin password=secure_password"
  }
}